# 世界数据库路径。相对路径以项目根目录为基准。
WORLD_DB_PATH=data/world.db

# 每次推进代表的世界分钟数。
WORLD_MINUTES_PER_TICK=60

# 独立 worker 两次自动推进之间的现实秒数。
WORLD_WORKER_INTERVAL_SECONDS=60

# 每轮最多进入详细决策阶段的人物数。
# 正式伊瑟拉世界(seed-isera)建议设为 8，聚焦核心人物、让背景 NPC 少被选中。
WORLD_ACTIVE_CHARACTER_LIMIT=10

# 决策器可选 rules 或 deepseek。默认 rules，避免未配置密钥时意外联网。
WORLD_DECISION_PROVIDER=rules

# DeepSeek直连配置。真实密钥只写入Git忽略的 .env，绝不能提交。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2
# DeepSeek 会先输出推理(reasoning_content)再给正文；上限需足够大，否则正文被截成空而降级成规则决策。
DEEPSEEK_MAX_OUTPUT_TOKENS=8192

# 本地世界设定RAG。多个Markdown文件或目录使用分号分隔。
WORLD_KNOWLEDGE_ENABLED=true
WORLD_KNOWLEDGE_PATHS=docs/worldbuilding;docs/knowledge
WORLD_KNOWLEDGE_TOP_K=6
WORLD_KNOWLEDGE_MAX_CONTEXT_CHARS=8000

# 世界历史日志。日志由SQLite客观事件自动生成，不提交到Git。
WORLD_HISTORY_LOG_ENABLED=true
WORLD_HISTORY_LOG_DIR=logs/worlds

# 世界时钟与连续状态。1.0表示现实1分钟等于世界1分钟。
WORLD_DEFAULT_TIME_SCALE=1.0
WORLD_ADJUDICATION_INTERVAL_MINUTES=720
WORLD_SATIETY_LOSS_PER_WORLD_HOUR=3.0
WORLD_ENERGY_LOSS_PER_WORLD_HOUR=2.0

# 多Agent世界编排。默认关闭以保持纯规则/单决策器行为；开启后启用
# 场景组装、事件导演Agent、活跃NPC Agent与场景叙事Agent(全部受预算/超时约束)。
WORLD_AGENT_ENABLED=false
# 每次裁判允许的Agent总预算(以推理token估算)，达到后优先保留玩家动作与战斗安全。
WORLD_AGENT_BUDGET_PER_HEARTBEAT=100
# 并行调用Agent的最大并发数。
WORLD_AGENT_MAX_CONCURRENCY=4
# 单个Agent调用的超时秒数，超时立即回退规则。
WORLD_AGENT_TIMEOUT_SECONDS=8
# 每轮最多进入活跃NPC Agent(详细决策)的人数。
WORLD_AGENT_ACTIVE_NPC_LIMIT=8
# 是否启用确定性的战斗子系统(CombatResolver + 遭遇表)。
WORLD_AGENT_COMBAT_ENABLED=false
