# 世界数据库路径。相对路径以项目根目录为基准。
WORLD_DB_PATH=data/world.db

# 每次推进代表的世界分钟数。
WORLD_MINUTES_PER_TICK=60

# 独立 worker 两次自动推进之间的现实秒数。
WORLD_WORKER_INTERVAL_SECONDS=60

# 每轮最多进入详细决策阶段的人物数。
WORLD_ACTIVE_CHARACTER_LIMIT=10

# 决策器可选 rules 或 deepseek。默认 rules，避免未配置密钥时意外联网。
WORLD_DECISION_PROVIDER=rules

# DeepSeek直连配置。真实密钥只写入Git忽略的 .env，绝不能提交。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_OUTPUT_TOKENS=2400

# 世界历史日志。日志由SQLite客观事件自动生成，不提交到Git。
WORLD_HISTORY_LOG_ENABLED=true
WORLD_HISTORY_LOG_DIR=logs/worlds

# 世界时钟与连续状态。1.0表示现实1分钟等于世界1分钟。
WORLD_DEFAULT_TIME_SCALE=1.0
WORLD_ADJUDICATION_INTERVAL_MINUTES=720
WORLD_HUNGER_PER_WORLD_HOUR=3.0
WORLD_ENERGY_LOSS_PER_WORLD_HOUR=2.0
